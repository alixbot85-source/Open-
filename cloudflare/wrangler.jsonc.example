{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shadowtm-core-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shadowtm-core",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://alixbot85-source.github.io"
  }
}
