generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id Int @id @default(autoincrement()) firstName String lastName String? email String @unique passwordHash String createdAt DateTime @default(now()) orders Order[] }
model Admin { id Int @id @default(autoincrement()) email String @unique passwordHash String createdAt DateTime @default(now()) }
model PaymentSettings { id Int @id @default(autoincrement()) tronAddress String? usdtTrc20Address String? updatedAt DateTime @updatedAt }

model Country { id Int @id @default(autoincrement()) name String @unique code String currency String funds FundProduct[] }
model Server { id Int @id @default(autoincrement()) protocol String name String cpu String ram String storage String bandwidth String price Decimal @db.Decimal(12,2) billingPeriod String @default("month") status String @default("active") pdfPath String? emailSubject String? emailBody String? deliveryDelayHours Int @default(2) orders Order[] }
model FundProduct { id Int @id @default(autoincrement()) countryId Int country Country @relation(fields:[countryId],references:[id]) currency String amount String price Decimal @db.Decimal(12,2) flag String status String @default("active") pdfPath String? emailSubject String? emailBody String? deliveryDelayHours Int @default(2) orders Order[] }
model Order { id Int @id @default(autoincrement()) userId Int user User @relation(fields:[userId],references:[id]) serverId Int? server Server? fundId Int? fund FundProduct? type String price Decimal @db.Decimal(12,2) status String @default("PENDING_PAYMENT") paymentCurrency String? paymentWallet String? txHash String? paymentSubmittedAt DateTime? paymentReviewedAt DateTime? deliveryEmail String? paymentApprovedAt DateTime? deliveryAt DateTime? createdAt DateTime @default(now()) items OrderItem[] delivery EmailDelivery? auditLogs AuditLog[] }
model OrderItem { id Int @id @default(autoincrement()) orderId Int order Order @relation(fields:[orderId],references:[id]) label String value String }
model Session { id String @id userId Int? adminId Int? expiresAt DateTime createdAt DateTime @default(now()) }
model DeliveryTemplate { id Int @id @default(autoincrement()) productType String @unique emailSubject String emailBody String pdfPath String? requiresPdf Boolean @default(false) updatedAt DateTime @updatedAt }
model EmailDelivery { id Int @id @default(autoincrement()) orderId Int @unique order Order @relation(fields:[orderId],references:[id]) userId Int email String pdfPath String? emailSubject String emailBody String deliveryData Json? scheduledFor DateTime status String @default("PENDING") attempts Int @default(0) lastAttemptAt DateTime? sentAt DateTime? errorMessage String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model AuditLog { id Int @id @default(autoincrement()) event String orderId Int? order Order? userId Int? actor String metadata Json? createdAt DateTime @default(now()) @@index([orderId, createdAt]) }
